#!/bin/sh
# 旁路由首启配置：WRT3200ACM + ImmortalWrt 24.10.6
# 主路由 192.168.1.1，本机 192.168.1.2

# 0. 系统基础设置
uci set system.@system[0].hostname='WRT3200ACM'
uci set system.@system[0].timezone='CST-8'
uci set system.@system[0].zonename='Asia/Shanghai'
uci commit system

# root 密码（chpasswd 在 uci-defaults 里比 passwd here-string 可靠）
echo 'root:SoftOEM@76' | chpasswd -c SHA512

uci set luci.main.lang='zh-cn'
uci set luci.main.mediaurlbase='/luci-static/argon'
uci commit luci

uci delete system.ntp.server 2>/dev/null
uci add_list system.ntp.server='ntp.aliyun.com'
uci add_list system.ntp.server='time1.cloud.tencent.com'
uci add_list system.ntp.server='time2.cloud.tencent.com'
uci set system.ntp.enabled='1'
uci set system.ntp.enable_server='0'
uci commit system

# 1. LAN 静态化
uci set network.lan.proto='static'
uci set network.lan.ipaddr='192.168.1.2'
uci set network.lan.netmask='255.255.255.0'
uci set network.lan.gateway='192.168.1.1'
uci set network.lan.dns='192.168.1.1'
uci delete network.lan.ip6assign 2>/dev/null
uci commit network

# 2. 关 LAN 侧 DHCP（主路由发地址）
uci set dhcp.lan.ignore='1'
uci commit dhcp

# 3. 关无线（不广播 SSID）
for w in $(uci show wireless | awk -F'[.=]' '/\.disabled=/{print $2}'); do
  uci set wireless.$w.disabled='1'
done
# 兜底：把 radio0/radio1 也显式关
uci set wireless.radio0.disabled='1' 2>/dev/null
uci set wireless.radio1.disabled='1' 2>/dev/null
uci commit wireless

# 4. 防火墙：LAN->WAN 全放行 + MASQUERADE（旁路由经典配置）
uci set firewall.@zone[0].forward='ACCEPT'   # lan zone
uci set firewall.@zone[0].input='ACCEPT'
uci set firewall.@zone[0].output='ACCEPT'
uci set firewall.@zone[1].masq='1'           # wan zone masquerade
uci commit firewall

# 5. LAN 放行 SSH（SCP 也走 22）/ dropbear 显式配置
uci set dropbear.@dropbear[0].enable='1'
uci set dropbear.@dropbear[0].Port='22'
uci set dropbear.@dropbear[0].PasswordAuth='on'
uci set dropbear.@dropbear[0].RootPasswordAuth='on'
uci set dropbear.@dropbear[0].Interface='lan'
uci commit dropbear

# 6. 可选：强制 LAN 口不走 WAN（3200ACM 多口，把 wan 口空着就行，不动也行）

# 7. 重启服务
service network restart
service dnsmasq restart
service firewall restart

# 8.自删
rm -f /etc/uci-defaults/99-custom

exit 0
