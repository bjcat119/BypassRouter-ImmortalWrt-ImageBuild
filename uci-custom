#!/bin/sh
#############################################
# WRT3200ACM 旁路由首启脚本
# ImmortalWrt 24.10.6 / mvebu-cortexa9
# 同网段旁路: LAN 192.168.1.2 / 网关 192.168.1.1
# 关 DHCP / 关无线 / 禁 IPv6 / HP TUN 透明代理
#############################################

### 0. 变量（按需修改）
LAN_IP="192.168.1.2"
MAIN_GW="192.168.1.1"
HOSTNAME="WRT3200ACM"
NTP1="ntp.aliyun.com"
NTP2="ntp.tencent.com"
DNS1="223.5.5.5"
DNS2="119.29.29.29"

echo "=== 1. 主机名 / 时区 / NTP / root 密码 ==="
uci set system.@system[0].hostname="$HOSTNAME"
uci set system.@system[0].zonename='Asia/Shanghai'
uci set system.@system[0].timezone='CST-8'
uci -q delete system.ntp.server
uci add_list system.ntp.server="$NTP1"
uci add_list system.ntp.server="$NTP2"
uci set system.ntp.enabled='1'
uci set system.ntp.enable_server='0'
echo 'SoftOEM@76' | passwd root --stdin 2>/dev/null || echo 'root:SoftOEM@76' | chpasswd
uci commit system

echo "=== 2. LAN 静态化 + 网关 + DNS + 禁 IPv6 委派 ==="
uci set network.lan.proto='static'
uci set network.lan.ipaddr="$LAN_IP"
uci set network.lan.netmask='255.255.255.0'
uci set network.lan.gateway="$MAIN_GW"
uci -q delete network.lan.dns
uci add_list network.lan.dns="$DNS1"
uci add_list network.lan.dns="$DNS2"
uci -q delete network.lan.ip6assign
uci -q delete network.lan.ip6hint
uci set network.lan.delegate='0'
uci commit network

echo "=== 3. DHCP 关闭 + IPv6 彻底禁用 + 停 odhcpd ==="
uci set dhcp.lan.ignore='1'
uci set dhcp.lan.dhcpv6='disabled'
uci set dhcp.lan.ra='disabled'
uci -q delete dhcp.lan.start
uci -q delete dhcp.lan.limit
uci -q delete dhcp.lan.leasetime
uci set dhcp.@dnsmasq[0].enable_tftp='0'
uci -q delete dhcp.@dnsmasq[0].tftp_root
uci set dhcp.@dnsmasq[0].dhcp_boot=''
uci set dhcp.@dnsmasq[0].filter_aaaa='1'
uci commit dhcp
/etc/init.d/odhcpd stop
/etc/init.d/odhcpd disable
rm -f /etc/rc.d/S*odhcpd

echo "=== 4. IPv6 策略：只禁 LAN 口，保留协议栈给 TUN ==="
cat > /etc/sysctl.d/99-disable-ipv6.conf << 'EOF'
net.ipv6.conf.br-lan.disable_ipv6 = 1
net.ipv6.conf.eth0.disable_ipv6 = 1
net.ipv6.conf.eth0.1.disable_ipv6 = 1
net.ipv6.conf.all.disable_ipv6 = 0
net.ipv6.conf.default.disable_ipv6 = 0
net.ipv6.conf.lo.disable_ipv6 = 0
EOF
sysctl -p /etc/sysctl.d/99-disable-ipv6.conf 2>/dev/null || true

echo "=== 5. 禁用无线 ==="
uci set wireless.radio0.disabled='1'
uci set wireless.radio1.disabled='1'
uci commit wireless

echo "=== 6. 防火墙: LAN 不MASQ / WAN 绑 lo ==="
uci set firewall.@zone[0].name='lan'
uci -q delete firewall.@zone[0].network
uci add_list firewall.@zone[0].network='lan'
uci set firewall.@zone[0].input='ACCEPT'
uci set firewall.@zone[0].output='ACCEPT'
uci set firewall.@zone[0].forward='ACCEPT'
uci set firewall.@zone[0].masq='0'
uci set firewall.@zone[0].mtu_fix='1'
uci set firewall.@zone[1].name='wan'
uci -q delete firewall.@zone[1].network
uci add_list firewall.@zone[1].network='lo'
uci set firewall.@zone[1].input='ACCEPT'
uci set firewall.@zone[1].output='ACCEPT'
uci set firewall.@zone[1].forward='ACCEPT'
uci set firewall.@zone[1].masq='1'
uci set firewall.@zone[1].mtu_fix='1'
uci set firewall.@defaults[0].input='ACCEPT'
uci set firewall.@defaults[0].output='ACCEPT'
uci set firewall.@defaults[0].forward='ACCEPT'
uci set firewall.@defaults[0].drop_invalid='0'
uci set firewall.@defaults[0].syn_flood='0'
uci set firewall.@defaults[0].synflood_protect='0'
uci set firewall.@defaults[0].flow_offloading='0'
uci set firewall.@defaults[0].fullcone='0'
uci -q delete firewall.@forwarding[0]
uci commit firewall

echo "=== 7. uHTTPd + Luci ==="
uci set uhttpd.main.listen_http='0.0.0.0:80'
uci set uhttpd.main.listen_https='0.0.0.0:443'
uci set uhttpd.main.cert='/etc/uhttpd.crt'
uci set uhttpd.main.key='/etc/uhttpd.key'
uci set luci.main.lang='zh_cn'
uci set luci.main.mediaurlbase='/luci-static/argon'
uci commit uhttpd
uci commit luci

echo "=== 8. ujail capabilities: TUN 需要 CAP_NET_ADMIN ==="
mkdir -p /etc/capabilities
cat > /etc/capabilities/sing-box-c.json << 'EOF'
{
  "bounding": [
    "CAP_NET_ADMIN",
    "CAP_NET_BIND_SERVICE",
    "CAP_NET_RAW",
    "CAP_SYS_ADMIN"
  ],
  "effective": [
    "CAP_NET_ADMIN",
    "CAP_NET_BIND_SERVICE",
    "CAP_NET_RAW",
    "CAP_SYS_ADMIN"
  ],
  "permitted": [
    "CAP_NET_ADMIN",
    "CAP_NET_BIND_SERVICE",
    "CAP_NET_RAW",
    "CAP_SYS_ADMIN"
  ]
}
EOF

echo "=== 9. Homeproxy: TUN 模式 + 关 IPv6 支持 + MTU 1400 ==="
uci set homeproxy.config.proxy_mode='tun'
uci set homeproxy.config.ipv6_support='0'
ucz set homeproxy.infra.tun_mtu='1400'
uci commit homeproxy

echo "=== 10. TUN 模块保险 ==="
if ! lsmod | grep -q "^tun "; then
    modprobe tun 2>/dev/null || opkg install kmod-tun 2>/dev/null
fi

echo "=== 11. 重启服务 ==="
uci commit
/etc/init.d/system reload
/etc/init.d/network restart
/etc/init.d/dnsmasq restart
fw4 reload
wifi reload
/etc/init.d/uhttpd restart

echo "=============================================="
echo "WRT3200ACM 旁路由配置完成"
echo "  管理地址 : http://$LAN_IP"
echo "  主机名   : $HOSTNAME"
echo "  IPv6     : LAN 口禁用 + odhcpd 已停"
echo "  无线     : 已关闭"
echo "  HP       : TUN 模式 + MTU 1400"
echo "  TUN      : CAP_NET_ADMIN + kmod-tun 已确认"
echo "=============================================="

rm -f /etc/uci-defaults/99-custom
exit 0
